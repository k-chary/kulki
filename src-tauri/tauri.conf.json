{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kulki",
  "version": "0.3.0",
  "identifier": "pl.kchary.kulki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kulki",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRERCRDQ4MzZGOTlFRjEKUldUeG52azJTTDNkNytqU2syaHVrN1NQdE5FOHFna2VHUnN4cDBkVjEvb1ZBV1EwUEtBVHNQMncK",
      "endpoints": ["https://github.com/k-chary/kulki/releases/latest/download/latest.json"]
    }
  }
}
